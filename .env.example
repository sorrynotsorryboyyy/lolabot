# ============================================
#  Lola — Configuration
#  Copiez ce fichier en « .env » et remplissez.
#  NE JAMAIS committer le fichier .env !
# ============================================

# --- Obligatoire ---

# Token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=votre_token_ici

# ID de l'application (Developer Portal > General Information > Application ID)
CLIENT_ID=123456789012345678

# ID de votre serveur Discord (clic droit sur le serveur > Copier l'ID)
# Nécessite le Mode Développeur : Paramètres > Avancés > Mode développeur
GUILD_ID=123456789012345678

# --- Optionnel ---

# Chemin de la base de données.
#   En local  : laisser vide (par défaut ./data/lola.db)
#   Sur Railway : /data/lola.db  (avec un Volume monté sur /data)
DB_PATH=

# Anti-raid : âge minimum du compte en jours pour rejoindre (0 = désactivé)
MIN_ACCOUNT_AGE_DAYS=7

# Anti-raid : nombre d'arrivées...
RAID_JOIN_THRESHOLD=5

# ...pendant cette fenêtre (en secondes) qui déclenche le lockdown automatique
RAID_JOIN_WINDOW_SECONDS=10
